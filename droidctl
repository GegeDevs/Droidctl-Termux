#!/usr/bin/env bash
# ============================================================
# droidctl — unified CLI for OCI images (crane) + Droidspaces
# containers, running entirely from Termux (root via su).
#
# Usage:
#   droidctl pull <image>                 crane export --platform linux/arm64 -> tarball
#   droidctl convert <image> [--cmd ...]  pull + extract + auto-prepare init (inittab, ds-init)
#   droidctl images                       list extracted rootfs (convert pool)
#   droidctl ps                           droidspaces show (running containers)
#   droidctl create <name> <image>        validate convert-pool rootfs before start
#   droidctl start <name> [--net=...]     start container (default --net=host)
#   droidctl stop <name>                  stop container
#   droidctl restart <name>               restart container
#   droidctl logs <name>                  tail container / daemon logs
#   droidctl exec <name> <cmd...>         run command inside container (non-interactive)
#   droidctl info <name>                  container info
#   droidctl check                        droidspaces kernel diagnostics
#   droidctl rm <name>                    stop + delete container + its rootfs
#   droidctl version                      show versions (droidspaces, crane)
#   droidctl help                         this message
#
# Env overrides:
#   DROIDSPACES_BIN   path to droidspaces binary (default /data/local/Droidspaces/bin/droidspaces)
#   CRANE_BIN         path to crane (default $HOME/crane)
#   DROIDCTL_IMGDIR   tarball dir (default $HOME/droidimages)
#   DROIDCTL_ROOTFS_DIR  rootfs dir (default $HOME/droidimg)
#   DROIDCTL_NET      default net mode (default host)
# ============================================================

DS="${DROIDSPACES_BIN:-/data/local/Droidspaces/bin/droidspaces}"
CRANE="${CRANE_BIN:-$HOME/crane}"
IMGDIR="${DROIDCTL_IMGDIR:-$HOME/droidimages}"
ROOTFS_DIR="${DROIDCTL_ROOTFS_DIR:-/data/local/tmp/droidimg}"
NET_DEFAULT="${DROIDCTL_NET:-host}"

# --- helpers -------------------------------------------------

die() { echo "droidctl: ERROR: $*" >&2; exit 1; }

need_crane() {
  if [ ! -x "$CRANE" ]; then
    if command -v crane >/dev/null 2>&1; then
      CRANE="$(command -v crane)"
    else
      die "crane not found. Put the binary at ~/crane or set CRANE_BIN." \
          "(get it from github.com/google/go-containerregistry)"
    fi
  fi
}

need_root_ds() {
  su -c "test -x '$DS'" 2>/dev/null || die "droidspaces binary not found at $DS (need root)"
}

img_name() { echo "$1" | tr '/:' '--'; }

# sanitize a --cmd string into config file name (optional)

# --- commands ------------------------------------------------

cmd_help() {
  sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
}

cmd_version() {
  need_root_ds
  echo "droidctl (crane + droidspaces wrapper)"
  echo "  droidspaces: $(su -c "$DS version" 2>/dev/null | head -1)"
  echo "  crane:       $($CRANE version 2>/dev/null || echo 'n/a')"
  echo "  imgdir:      $IMGDIR"
  echo "  rootfs dir:  $ROOTFS_DIR"
}

cmd_pull() {
  [ $# -ge 1 ] || die "usage: droidctl pull <image>"
  need_crane
  mkdir -p "$IMGDIR"
  local ref img
  ref="$1"; img="$(img_name "$ref")"
  echo "droidctl: pulling $ref (linux/arm64) ..."
  "$CRANE" export --platform linux/arm64 "$ref" - > "$IMGDIR/$img.tar" \
    || die "pull failed (DNS? run DNSResolve module so crane works in Termux)"
  echo "droidctl: saved $IMGDIR/$img.tar ($(du -h "$IMGDIR/$img.tar" | cut -f1))"
}

cmd_convert() {
  [ $# -ge 1 ] || die "usage: droidctl convert <image> [--cmd \"entrypoint args\"]"
  need_crane
  local ref img cmd="" extra=""
  ref="$1"; shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --cmd) cmd="$2"; shift 2 ;;
      *) extra="$extra $1"; shift ;;
    esac
  done
  img="$(img_name "$ref")"

  # 1. pull if tarball missing
  if [ ! -f "$IMGDIR/$img.tar" ]; then
    cmd_pull "$ref" || return 1
  fi

  # 2. extract to rootfs dir
  local rootfs="$ROOTFS_DIR/$img"
  if [ -d "$rootfs" ] && [ "$(ls -A "$rootfs" 2>/dev/null | wc -l)" -gt 0 ]; then
    echo "droidctl: rootfs already exists at $rootfs (skipping extract)"
  else
    echo "droidctl: extracting to $rootfs ..."
    su -c "mkdir -p '$rootfs'"
    # /data/local/tmp is ext4 → hardlinks OK; tar toybox lacks --hard-dereference,
    # so run with PATH that prefers GNU tar from Termux.
    local tarout
    tarout="$(su -c "PATH=/data/data/com.termux/files/usr/bin:\$PATH tar --hard-dereference -xf '$IMGDIR/$img.tar' -C '$rootfs'" 2>&1)"
    local rc=$?
    [ $rc -eq 0 ] || { echo "$tarout" | tail -5; die "extract failed (rc=$rc)"; }
    # fix ownership so we can inspect later
    su -c "chown -R \$(stat -c '%u:%g' '$IMGDIR') '$rootfs' 2>/dev/null || true"
  fi

  # verify architecture of a key binary (best effort)
  local probe
  probe="$(find "$rootfs" -type f -perm -111 2>/dev/null | head -1)"
  if [ -n "$probe" ]; then
    local arch
    arch="$(file "$probe" 2>/dev/null | grep -oE 'aarch64|arm64|x86-64|ELF 32-bit' | head -1 || true)"
    case "$arch" in
      aarch64|arm64) echo "droidctl: arch OK (arm64)" ;;
      x86-64) die "arch mismatch: $probe is x86-64. This image has no arm64 variant (or crane old)." ;;
      *) echo "droidctl: note: could not detect arch of $probe" ;;
    esac
  fi

  # 3. prepare init (inittab + ds-init) — the gotcha we learned
  if [ -z "$cmd" ]; then
    case "$img" in
      *nginx*)    cmd="nginx -g 'daemon off;'" ;;
      *redis*)    cmd="redis-server --daemonize no" ;;
      *)          if [ -x "$rootfs/docker-entrypoint.sh" ]; then
                    cmd="/docker-entrypoint.sh"
                  elif [ -x "$rootfs/usr/local/bin/docker-entrypoint.sh" ]; then
                    cmd="/usr/local/bin/docker-entrypoint.sh"
                  fi ;;
    esac
  fi

  if [ -n "$cmd" ]; then
    su -c "mkdir -p '$rootfs/usr/local/bin' && cat > '$rootfs/usr/local/bin/ds-init' <<EOF
#!/bin/sh
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
exec $cmd
EOF
chmod +x '$rootfs/usr/local/bin/ds-init'" || die "gagal tulis ds-init"
  else
    # no known entrypoint: keep container alive so `droidctl exec` works
    su -c "mkdir -p '$rootfs/usr/local/bin' && cat > '$rootfs/usr/local/bin/ds-init' <<'EOF'
#!/bin/sh
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
echo \"[droidctl] no entrypoint detected; idle loop (use: droidctl exec <name> <cmd>)\"
exec /bin/sh -c 'while :; do sleep 3600; done'
EOF
chmod +x '$rootfs/usr/local/bin/ds-init'" || die "gagal tulis ds-init"
  fi

  # busybox-init images: replace inittab if it references openrc (missing in images)
  if su -c "grep -q 'openrc' '$rootfs/etc/inittab'" 2>/dev/null; then
    su -c "cat > '$rootfs/etc/inittab' <<'EOF'
::sysinit:/usr/local/bin/ds-init
::shutdown:/bin/busybox poweroff
EOF"
    echo "droidctl: replaced openrc inittab with minimal one"
  elif ! su -c "test -e '$rootfs/etc/inittab'" 2>/dev/null && su -c "test -e '$rootfs/sbin/init'" 2>/dev/null; then
    su -c "cat > '$rootfs/etc/inittab' <<'EOF'
::sysinit:/usr/local/bin/ds-init
::shutdown:/bin/busybox poweroff
EOF"
    echo "droidctl: wrote minimal inittab (image had none)"
  fi

  # Ensure /sbin/init exists (droidspaces requires it). For busybox-style
  # images, link it to the busybox binary (multi-call).
  if ! su -c "test -e '$rootfs/sbin/init'" 2>/dev/null; then
    if su -c "test -e '$rootfs/bin/busybox'" 2>/dev/null; then
      su -c "mkdir -p '$rootfs/sbin' && ln -sf /bin/busybox '$rootfs/sbin/init'"
      echo "droidctl: linked /sbin/init -> /bin/busybox"
    elif su -c "test -e '$rootfs/usr/bin/busybox'" 2>/dev/null; then
      su -c "mkdir -p '$rootfs/sbin' && ln -sf /usr/bin/busybox '$rootfs/sbin/init'"
      echo "droidctl: linked /sbin/init -> /usr/bin/busybox"
    fi
  fi

  echo "droidctl: convert OK — rootfs at $rootfs"
  echo "droidctl: next -> droidctl start ${img}"
}

cmd_images() {
  [ -d "$ROOTFS_DIR" ] || { echo "(no rootfs pool yet: $ROOTFS_DIR)"; return 0; }
  echo "=== rootfs pool ($ROOTFS_DIR) ==="
  for d in "$ROOTFS_DIR"/*/; do
    [ -d "$d" ] || continue
    local name size init
    name="$(basename "$d")"
    size="$(du -sh "$d" 2>/dev/null | cut -f1)"
    init="n/a"
    [ -x "$d/usr/local/bin/ds-init" ] && init="ds-init"
    [ -x "$d/sbin/init" ] && init="$init+init"
    printf "  %-24s %8s  %s\n" "$name" "$size" "$init"
  done
}

cmd_ps() {
  need_root_ds
  su -c "$DS show" 2>/dev/null || echo "(droidspaces show failed / no daemon)"
}

cmd_create() {
  [ $# -ge 2 ] || die "usage: droidctl create <name> <image>"
  local name="$1" img="$(img_name "$2")"
  local rootfs="$ROOTFS_DIR/$img"
  [ -d "$rootfs" ] || die "rootfs for '$img' not found — run: droidctl convert $2"
  echo "droidctl: container '$name' will use rootfs $rootfs"
  echo "droidctl: start with -> droidctl start $name"
}

cmd_start() {
  [ $# -ge 1 ] || die "usage: droidctl start <name> [--net=host|nat|none] [--port X:Y] [--rootfs=PATH]"
  need_root_ds
  local name="$1"; shift
  local net="$NET_DEFAULT" port="" extra="" rootfs=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --net=*) net="${1#--net=}" ;;
      --port*) port="$1 $2"; shift ;;
      --rootfs=*) rootfs="${1#--rootfs=}" ;;
      *) extra="$extra $1" ;;
    esac
    shift
  done
  # Auto-resolve rootfs from the conversion pool if container name matches an image
  if [ -z "$rootfs" ] && [ -d "$ROOTFS_DIR/$name" ]; then
    rootfs="$ROOTFS_DIR/$name"
    echo "droidctl: using rootfs from pool: $rootfs"
  fi
  if [ -n "$rootfs" ]; then
    su -c "$DS --name=$name --rootfs='$rootfs' --net=$net $port $extra start" 2>&1 | grep -Ev '^$' || return 1
  else
    su -c "$DS --name=$name --net=$net $port $extra start" 2>&1 | grep -Ev '^$' || return 1
  fi
}

cmd_stop() {
  [ $# -ge 1 ] || die "usage: droidctl stop <name>"
  need_root_ds
  su -c "$DS --name=$1 stop" 2>&1 | grep -Ev '^$' || true
}

cmd_restart() {
  [ $# -ge 1 ] || die "usage: droidctl restart <name>"
  need_root_ds
  su -c "$DS --name=$1 restart" 2>&1 | grep -Ev '^$' || true
}

cmd_logs() {
  [ $# -ge 1 ] || die "usage: droidctl logs <name>"
  need_root_ds
  local name="$1"
  echo "=== daemon log (droidspacesd.log, grep $name) ==="
  su -c "tail -n 200 /data/local/Droidspaces/Logs/droidspacesd.log 2>/dev/null | grep -i '$name' | tail -25"
  echo "=== container log files ==="
  su -c "ls -t /data/local/Droidspaces/Logs/*$name* 2>/dev/null | head -3"
  su -c "for f in /data/local/Droidspaces/Logs/*$name*; do [ -f \"\$f\" ] && { echo \"--- \$f ---\"; tail -n 20 \"\$f\"; }; done" 2>/dev/null
}

cmd_exec() {
  [ $# -ge 2 ] || die "usage: droidctl exec <name> <cmd...>"
  need_root_ds
  local name="$1"; shift
  local joined="$*"
  joined="${joined//\'/\'\\\'\'}"
  su -c "$DS --name=$name run sh -c '$joined'"
}

cmd_info() {
  [ $# -ge 1 ] || die "usage: droidctl info <name>"
  need_root_ds
  su -c "$DS --name=$1 info" 2>&1 | grep -Ev '^$' || true
}

cmd_check() {
  need_root_ds
  su -c "$DS check" 2>&1 | grep -Ev '^$' || true
}

cmd_rm() {
  [ $# -ge 1 ] || die "usage: droidctl rm <name>"
  need_root_ds
  local name="$1"
  su -c "$DS --name=$name stop" >/dev/null 2>&1 || true
  su -c "rm -rf /data/local/Droidspaces/Containers/$name /data/local/Droidspaces/Pids/$name 2>/dev/null" || true
  # also remove from the conversion pool if the name matches a pool image (rm as root)
  su -c "rm -rf '$ROOTFS_DIR/$name' 2>/dev/null" && echo "droidctl: removed rootfs $ROOTFS_DIR/$name"
  echo "droidctl: container '$name' removed"
}

# --- dispatch ------------------------------------------------

CMD="${1:-help}"; [ $# -gt 0 ] && shift

case "$CMD" in
  pull)      cmd_pull "$@" ;;
  convert)   cmd_convert "$@" ;;
  images)    cmd_images ;;
  ps)        cmd_ps ;;
  create)    cmd_create "$@" ;;
  start)     cmd_start "$@" ;;
  stop)      cmd_stop "$@" ;;
  restart)   cmd_restart "$@" ;;
  logs)      cmd_logs "$@" ;;
  exec)      cmd_exec "$@" ;;
  info)      cmd_info "$@" ;;
  check)     cmd_check ;;
  rm)        cmd_rm "$@" ;;
  version)   cmd_version ;;
  help|-h|--help) cmd_help ;;
  *) die "unknown command '$CMD' (see: droidctl help)" ;;
esac